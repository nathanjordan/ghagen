{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src"],
  // The publish boundary, and nothing else: `npm run build` runs `tsc` over
  // this config and `files: ["dist"]` ships what it emits, so tests and the
  // test-only modules under `src/` stay out. It is deliberately NOT the gate's
  // scope -- `npm run typecheck` uses `tsconfig.typecheck.json`, which extends
  // this file and narrows `exclude` back to `node_modules`/`dist`. Adding an
  // entry here therefore keeps a module out of `dist/` without taking it out of
  // `tsc`, which is the whole of docs/issues/09.
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/integration/test-utils.ts",
    "src/integration/fixture-models.ts",
    "src/pin/transport-contract.ts",
    "src/paths.ts"
  ]
}
